-- Indian Railways Analytics
-- DAX Measures Reference
-- Power BI | Fare, Distance, Charges and Route Analysis

-- 1. Fare & Revenue Measures

Total Fare Value =
SUM(FactFare[Total Fare])

Fare Average =
AVERAGE(FactFare[Total Fare])

Highest Fare =
MAX(FactFare[Total Fare])

Lowest Fare =
MIN(FactFare[Total Fare])

Base Fare Average =
AVERAGE(FactFare[Base Fare])

Additional Charges Average =
[Fare Average] - [Base Fare Average]

Fare Markup % =
DIVIDE(
    [Fare Average] - [Base Fare Average],
    [Base Fare Average]
)

-- 2. Distance Measures

Distance Total =
SUM(FactFare[Distance (km)])

Distance Average =
AVERAGE(FactFare[Distance (km)])

Average Fare per KM =
DIVIDE(
    [Fare Average],
    [Distance Average]
)

Overall Fare per KM =
DIVIDE(
    [Total Fare Value],
    [Distance Total]
)

-- 3. Additional Charge Measures

Reservation Charge Average =
AVERAGE(FactFare[Reservation Charge])

Superfast Charge Average =
AVERAGE(FactFare[Superfast Charge])

Service Tax Average =
AVERAGE(FactFare[Service Tax])

Dynamic Fare Average =
AVERAGE(FactFare[Dynamic Fare])

Catering Charge Average =
AVERAGE(FactFare[Catering Charge])

Other Charge Average =
AVERAGE(FactFare[Other Charge])

-- 4. Train & Route Measures

Active Train Count =
DISTINCTCOUNT(FactFare[Train Number])

Unique Route Count =
COUNTROWS(
    SUMMARIZE(
        FactFare,
        FactFare[From Station],
        FactFare[To Station]
    )
)
